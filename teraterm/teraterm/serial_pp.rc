// Microsoft Visual C++ resource script.
//
#include "serial_pp_res.h"

#define APSTUDIO_READONLY_SYMBOLS
#include <winresrc.h>
#define IDC_STATIC -1
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "serial_pp_res.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include <winresrc.h>\r\n"
    "#define IDC_STATIC -1\0"
END

3 TEXTINCLUDE
BEGIN
    "\0"
END
#endif

IDD_SERIALDLG DIALOGEX 20, 20, 276, 269
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Tera Term: Serial port setup and connection"
FONT 8, "Tahoma", 400, 0, 0x0
BEGIN
    CONTROL         "&Port:",IDC_SERIALPORT_LABEL,"Static",SS_LEFTNOWORDWRAP,15,9,54,8
    COMBOBOX        IDC_SERIALPORT,75,7,62,52,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Sp&eed:",IDC_SERIALBAUD_LEBAL,"Static",SS_LEFTNOWORDWRAP,15,24,54,8
    COMBOBOX        IDC_SERIALBAUD,75,22,62,100,CBS_DROPDOWN | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Data:",IDC_SERIALDATA_LABEL,"Static",SS_LEFTNOWORDWRAP,15,39,54,8
    COMBOBOX        IDC_SERIALDATA,75,37,62,35,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "P&arity:",IDC_SERIALPARITY_LABEL,"Static",SS_LEFTNOWORDWRAP,15,54,54,8
    COMBOBOX        IDC_SERIALPARITY,75,52,62,65,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Stop bits:",IDC_SERIALSTOP_LABEL,"Static",SS_LEFTNOWORDWRAP,15,69,54,8
    COMBOBOX        IDC_SERIALSTOP,75,67,62,40,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Flow control:",IDC_SERIALFLOW_LABEL,"Static",SS_LEFTNOWORDWRAP,15,84,54,8
    COMBOBOX        IDC_SERIALFLOW,75,82,62,53,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "CTS",IDC_CHECK_CTS,15,99,26,10,WS_DISABLED
    CHECKBOX        "RTS",IDC_CHECK_RTS,46,99,26,10
    COMBOBOX        IDC_SERIALRTS,75,99,62,52,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "DSR",IDC_CHECK_DSR,15,114,26,10,WS_DISABLED
    CHECKBOX        "DTR",IDC_CHECK_DTR,46,114,26,10
    COMBOBOX        IDC_SERIALDTR,75,114,62,52,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "RING",IDC_CHECK_RING,15,129,29,10,WS_DISABLED
    CHECKBOX        "RLSD",IDC_CHECK_RLSD,46,129,29,10,WS_DISABLED
    GROUPBOX        "Transmit delay",IDC_SERIALDELAY,12,147,152,32
    LTEXT           "msec/&char",IDC_SERIALDELAYCHAR_LABEL,46,161,42,10
    EDITTEXT        IDC_SERIALDELAYCHAR,22,159,20,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "msec/&line",IDC_SERIALDELAYLINE_LABEL,116,161,42,10
    EDITTEXT        IDC_SERIALDELAYLINE,93,159,20,13,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_SERIALTEXT,10,187,254,72,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
END

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_SERIALDLG, DIALOG
    BEGIN
        RIGHTMARGIN, 185
        VERTGUIDE, 75
        VERTGUIDE, 137
        BOTTOMMARGIN, 185
        HORZGUIDE, 185
    END
END
#endif
#endif
